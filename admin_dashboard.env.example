# Admin Dashboard Configuration
# Copy this to .env and fill in your values

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_SECRET_KEY=your-secret-key-here-change-this

# Dashboard Settings
ADMIN_DASHBOARD_PORT=8090
DASHBOARD_REFRESH=30

# Bot Configuration (if using env vars instead of JSON)
# Format: BOT_<number>_<property>

# Bot 1
BOT_1_NAME=btc1
BOT_1_URL=https://btc1.up.railway.app
BOT_1_USER=john@example.com
BOT_1_DESC=Main BTC trading bot
BOT_1_COLOR=#007bff

# Bot 2
BOT_2_NAME=btc2
BOT_2_URL=https://btc2.up.railway.app
BOT_2_USER=sarah@example.com
BOT_2_DESC=Secondary BTC bot
BOT_2_COLOR=#28a745

