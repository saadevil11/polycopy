# polybotshadow — Polymarket copytrader (Rust). Copy to .env and fill in.
# Secrets (PRIVATE_KEY) must NEVER be committed.

# ── Wallet / auth ────────────────────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_EOA_PRIVATE_KEY        # signer key (NOT committed)
FUNDER_ADDRESS=0xYOUR_POLYMARKET_PROXY    # Polymarket wallet address (from profile)
SIGNATURE_TYPE=2                          # 2 = Gnosis-Safe (old/pre-v2 wallets); 1 = browser-wallet proxy;
                                          #   3 = POLY_1271 "deposit wallet" (NEW post-v2 accounts — maker=signer=funder)
# Pre-created CLOB API credentials (OPTIONAL). The bot derives its own key via L1
# for every signature type — including type 3 deposit wallets (ERC-1271-wrapped
# ClobAuth). Only set these if that derivation is rejected by the CLOB: create an
# API key for the deposit-wallet account on Polymarket and paste it here to skip
# derivation. If all three are set they're used as-is.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# ── Safety ───────────────────────────────────────────────────────────────────
DRY_RUN=true                              # true = log would-be orders, place NOTHING
# Signing is byte-identical to py-clob-client-v2 (gate PASSED — see ARCHITECTURE.md).
# Keep this false until you've funded pUSD + set exchange allowances and done one
# tiny live POST /order. Live mode needs DRY_RUN=false AND this =true.
LIVE_SIGNING_VALIDATED=false

# ── Target / data source ─────────────────────────────────────────────────────
TARGET_TRADER_ADDRESS=0x85dbcb1712ca38c639559351ad31127c472e1423   # the trader we copy
# How we detect the target's trades:
#   rest = Data-API polling   — slower (~1-3s) but works on datacenter IPs (AWS). RECOMMENDED on AWS.
#   ws   = activity WebSocket — faster (push), but Polymarket 429-throttles it on datacenter IPs;
#          only use ws from a residential / allowed-region IP (e.g. behind your proxy).
DATA_SOURCE=rest
COPY_POLL_MS=1000                         # Data-API poll cadence (DATA_SOURCE=rest only)

# ── brownfox mode (the requested strategy) ───────────────────────────────────
# One fixed-SHARE buy per market at the target's exact price, mark a resting sell
# at buy+markup, forced exit if they sell below it. Holdings-driven + restart-safe.
USE_BROWNFOX_MODE=true                     # true = run brownfox (else general copy below)
BROWNFOX_TRADE_SIZE_SHARES=50              # fixed SHARE count per market (not USD)
BROWNFOX_SELL_MARKUP=0.01                  # resting sell at buy + this (+1 cent)
BROWNFOX_RECONCILE_MS=3000                 # holdings/orders reconcile cadence
BROWNFOX_MARKET_SELL_RETRIES=8             # forced-exit market-sell retry attempts

# ── 99c mode (buy-and-hold) ──────────────────────────────────────────────────
# Like brownfox's ENTRY, but no sell/exit: for each market the target enters,
# place ONE fixed-share buy at the target's price and HOLD to resolution. For
# targets that buy near 1.0 (e.g. BTC 5-min at 0.99) and hold. One buy per
# market; target SELLs are ignored. Takes priority over brownfox if both are on.
USE_99C_MODE=false                         # true = run 99c (overrides brownfox/copy)
NINETYNINE_TRADE_SIZE_SHARES=50            # fixed SHARE count per market (≥5)
NINETYNINE_RECONCILE_MS=5000               # fill-check / stale-cancel cadence
NINETYNINE_BUY_MAX_AGE_SECS=600            # cancel an UNFILLED buy after this many secs (0 = never)
NINETYNINE_MAX_CONCURRENT_BUYS=8           # parallel buy placements across markets (bounds rate-limits)
# Only copy <asset>-updown-<dur>-* markets for these assets (empty = copy ALL markets
# the target buys). Matches the slug, e.g. btc-updown-5m-1781742900.
NINETYNINE_ASSETS=btc,eth,xrp,doge,bnb,hype
# Which market durations to copy (comma list). Default = both 5- and 15-minute.
# Set to "5m" to DISABLE 15-minute trading; "15m" for only 15-minute.
NINETYNINE_DURATIONS=5m,15m

# ── 99c order-book SCANNER (self-driven; NO target trader) ────────────────────
# Watches the order books of ALL <asset>-updown-5m markets (NINETYNINE_ASSETS) on the
# CLOB market websocket and places a GTC buy when a market's best ASK reaches 0.99 —
# then HOLDS to resolution (buy-and-hold like 99c, but driven by the book, not a copied
# trader, so it doesn't miss positions). Runs INSTEAD of the copytrader (set the others
# off). Reuses NINETYNINE_ASSETS + NINETYNINE_BUY_MAX_AGE_SECS + NINETYNINE_RECONCILE_MS
# + NINETYNINE_MAX_CONCURRENT_BUYS.
USE_99C_SCANNER_MODE=false
SCANNER_TRADE_SIZE_SHARES=10              # shares per market (>= 5)
SCANNER_BUY_PRICE=0.99                    # GTC buy limit price
SCANNER_TRIGGER_ASK=0.99                  # fire when best ask >= this and < 1.0
SCANNER_DISCOVERY_SECS=30                 # how often to re-scan Gamma for open 5m markets

# ── sell-with-target mode (brownfox entry, exit WITH the target) ─────────────
# Same one-fixed-share buy per market as brownfox, but NO +1c resting sell: on
# the target's FIRST sell in that market, market-sell ALL our shares (any price).
# The sell runs on a non-blocking worker, so other markets keep trading. Takes
# priority over brownfox if both are on (but below 99c).
USE_SELL_WITH_TARGET_MODE=false
SELL_WITH_TARGET_TRADE_SIZE_SHARES=50      # fixed SHARE count per market (≥5)
SELL_WITH_TARGET_RECONCILE_MS=3000         # how often we refresh our buy fill while waiting
# ENTRY is a single-shot FAK (fill-and-kill) MARKET buy: a marketable limit placed
# this far ABOVE the best ask so it crosses and fills now, cancelling any unfilled
# remainder (we hold exactly what filled). A limit at the target's stale price rarely
# fills — the book moved up. Bigger = fills deeper/surer, slightly worse price. <1.0.
SELL_WITH_TARGET_BUY_AHEAD=0.03
# Our true avg cost is read from our fills (/data/trades) at exit; the exit style is
# chosen vs that cost (see SELL_WITH_TARGET_EXIT_PRICE below).
# Exit style depends on the target's sell price vs OUR AVERAGE FILL COST (read from
# our /data/trades at exit):
#  • target sold AT/ABOVE our cost (profit) → CHASE THE BID: sell at ~the top of book
#    each round so we capture the good prices (0.52, 0.51, …) instead of dumping deep.
#  • target sold BELOW our cost (loss) → DUMP: one GTC SELL at the floor below, a
#    marketable limit that crosses the whole bid side (rejection-proof on a crash) and
#    rests any remainder at the floor. The floor also mops up any profit-case leftover.
# This floor price (lower = more certain to clear; the worst price we'll accept):
SELL_WITH_TARGET_EXIT_PRICE=0.10
SELL_WITH_TARGET_MARKET_SELL_RETRIES=8     # retries for PLACING the exit order (transient POST errors)

# ── General copy replicator (used when USE_BROWNFOX_MODE=false) ───────────────
COPY_PERCENTAGE=0.1                        # fraction of the target's size to copy
MAX_POSITIONS=0                            # distinct-market cap for NEW markets (0 = unlimited)
MIN_TARGET_TRADE_VALUE_USD=4              # skip target trades smaller than this (USD)

# weather execution (price-chasing) — optional, replicator only
USE_WEATHER_MODE=false                     # chase 1c ahead on buys / 1 tick down on sells
WEATHER_BUY_AHEAD=0.01                     # place a BUY this far above the target
WEATHER_MAX_CHASES=5
WEATHER_FILL_WAIT_MS=2000
WEATHER_MAX_BUY_PRICE=0.996                # never chase a buy above this

# auto-sell limit (resting standard-price sell on every copied position)
AUTO_SELL_ENABLED=false
AUTO_SELL_PRICE=0.999
AUTO_SELL_MAINTAIN_MS=20000
AUTO_SELL_EXACT_THRESHOLD=0.97             # match target's exact sell price when >= this

# stale-order sweep (cancel resting BUYs once their market runs near 1.0)
STALE_ORDER_SWEEP_ENABLED=false
STALE_ORDER_CANCEL_PRICE=0.995
STALE_ORDER_SWEEP_SECS=30

# ── Infra ────────────────────────────────────────────────────────────────────
COPY_DATA_DIR=/data                        # persistent state dir (dedup + brownfox)
DASHBOARD_PORT=8090                        # http://localhost:8090
LOG_LEVEL=info
