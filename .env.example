# polybotshadow — Polymarket copytrader (Rust). Copy to .env and fill in.
# Secrets (PRIVATE_KEY) must NEVER be committed.

# ── Wallet / auth ────────────────────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_EOA_PRIVATE_KEY        # signer key (NOT committed)
FUNDER_ADDRESS=0xYOUR_POLYMARKET_PROXY    # Polymarket wallet address (from profile)
SIGNATURE_TYPE=2                          # 2 = Gnosis-Safe proxy (most users)

# ── Safety ───────────────────────────────────────────────────────────────────
DRY_RUN=true                              # true = log would-be orders, place NOTHING
# Signing is byte-identical to py-clob-client-v2 (gate PASSED — see ARCHITECTURE.md).
# Keep this false until you've funded pUSD + set exchange allowances and done one
# tiny live POST /order. Live mode needs DRY_RUN=false AND this =true.
LIVE_SIGNING_VALIDATED=false

# ── Target / data source ─────────────────────────────────────────────────────
TARGET_TRADER_ADDRESS=0x85dbcb1712ca38c639559351ad31127c472e1423   # the trader we copy
# How we detect the target's trades:
#   rest = Data-API polling   — slower (~1-3s) but works on datacenter IPs (AWS). RECOMMENDED on AWS.
#   ws   = activity WebSocket — faster (push), but Polymarket 429-throttles it on datacenter IPs;
#          only use ws from a residential / allowed-region IP (e.g. behind your proxy).
DATA_SOURCE=rest
COPY_POLL_MS=1000                         # Data-API poll cadence (DATA_SOURCE=rest only)

# ── brownfox mode (the requested strategy) ───────────────────────────────────
# One fixed-SHARE buy per market at the target's exact price, mark a resting sell
# at buy+markup, forced exit if they sell below it. Holdings-driven + restart-safe.
USE_BROWNFOX_MODE=true                     # true = run brownfox (else general copy below)
BROWNFOX_TRADE_SIZE_SHARES=50              # fixed SHARE count per market (not USD)
BROWNFOX_SELL_MARKUP=0.01                  # resting sell at buy + this (+1 cent)
BROWNFOX_RECONCILE_MS=3000                 # holdings/orders reconcile cadence
BROWNFOX_MARKET_SELL_RETRIES=8             # forced-exit market-sell retry attempts

# ── General copy replicator (used when USE_BROWNFOX_MODE=false) ───────────────
COPY_PERCENTAGE=0.1                        # fraction of the target's size to copy
MAX_POSITIONS=0                            # distinct-market cap for NEW markets (0 = unlimited)
MIN_TARGET_TRADE_VALUE_USD=4              # skip target trades smaller than this (USD)

# weather execution (price-chasing) — optional, replicator only
USE_WEATHER_MODE=false                     # chase 1c ahead on buys / 1 tick down on sells
WEATHER_BUY_AHEAD=0.01                     # place a BUY this far above the target
WEATHER_MAX_CHASES=5
WEATHER_FILL_WAIT_MS=2000
WEATHER_MAX_BUY_PRICE=0.996                # never chase a buy above this

# auto-sell limit (resting standard-price sell on every copied position)
AUTO_SELL_ENABLED=false
AUTO_SELL_PRICE=0.999
AUTO_SELL_MAINTAIN_MS=20000
AUTO_SELL_EXACT_THRESHOLD=0.97             # match target's exact sell price when >= this

# stale-order sweep (cancel resting BUYs once their market runs near 1.0)
STALE_ORDER_SWEEP_ENABLED=false
STALE_ORDER_CANCEL_PRICE=0.995
STALE_ORDER_SWEEP_SECS=30

# ── Infra ────────────────────────────────────────────────────────────────────
COPY_DATA_DIR=/data                        # persistent state dir (dedup + brownfox)
DASHBOARD_PORT=8090                        # http://localhost:8090
LOG_LEVEL=info
