# Polymarket Copy Trading Bot Configuration

# REQUIRED: Your wallet private key (without 0x prefix)
PRIVATE_KEY=paMtANCdEitWdqBccrFX5HFUeWkaVRKe6esJ5va68X9jxbaWSM7wbr8ZmBnJez3cLzdheA8yWZVbJxkSqmi7wfy

# ⚠️  CRITICAL: Use your POLYMARKET wallet address, NOT your MetaMask address!
# This is the address shown in the top right of Polymarket under your profile name
# It's usually different from your MetaMask address and starts with 0x
FUNDER_ADDRESS=0xde9be3a24222bf43f7a900f237849de561e8178b

# REQUIRED: Target trader address to copy
TARGET_TRADER_ADDRESS=0x35c0732e069faea97c11aa9cab045562eaab81d6

# Wallet signature type (0=EOA/MetaMask, 1=Email/Magic, 2=Proxy)
# ⚠️  Most Polymarket users should use SIGNATURE_TYPE=2 (Proxy wallet)
SIGNATURE_TYPE=2

# Trading Configuration
COPY_PERCENTAGE=0.1                    # Percentage of target's position size to copy (1.0 = 100%)
MAX_POSITION_SIZE_USD=1000            # Maximum position size in USD
MIN_POSITION_SIZE_USD=10              # Minimum position size in USD
MAX_DAILY_LOSS_USD=500               # Maximum daily loss limit in USD
MAX_POSITIONS=10                     # Maximum number of open positions
TRADE_DELAY_SECONDS=0                # Delay before copying trades (0=instant, 5=safer but slower)
MONITORING_INTERVAL_SECONDS=1       # How often to check for new trades
MIN_MARKET_LIQUIDITY_USD=1000        # Only trade markets with minimum liquidity

# Bot Configuration
LOG_LEVEL=INFO                       # Logging level (DEBUG, INFO, WARNING, ERROR)
DRY_RUN=true                       # Set to 'true' to simulate trades without executing
COPY_MERGE_ACTIONS=true            # Copy merge actions from target trader (true/false)
COPY_REDEEM_ACTIONS=true           # Copy redeem actions from target trader (true/false)

# Market Filters (comma-separated, leave empty to copy all markets)
MARKET_FILTERS=Bitcoin Up or Down on,Ethereum Up or Down on,Solana Up or Down on

# Optional: Telegram Alerts
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# API Endpoints (usually don't need to change)
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
