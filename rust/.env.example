# ── Wallet / auth (same as the copy-trader) ──────────────────────────────────
PRIVATE_KEY=0xYOUR_EOA_PRIVATE_KEY        # signer key (NOT committed)
FUNDER_ADDRESS=0xYOUR_POLYMARKET_PROXY    # Polymarket wallet address (from profile)
SIGNATURE_TYPE=2                          # 2 = Gnosis-Safe proxy (most users)

# ── Safety ───────────────────────────────────────────────────────────────────
DRY_RUN=true                              # true = log would-be orders, place NOTHING
# Signing is byte-identical to py-clob-client-v2 (gate PASSED — see ARCHITECTURE.md §7).
# Keep this false until you've also funded pUSD + set exchange allowances and done
# one tiny live POST /order. Live mode needs DRY_RUN=false AND this =true.
LIVE_SIGNING_VALIDATED=false

# ── Market data ──────────────────────────────────────────────────────────────
DATA_SOURCE=ws                            # ws = CLOB market socket (realtime) + REST resync; rest = poll /books
REST_POLL_MS=400                          # poll cadence when DATA_SOURCE=rest

# ── Which markets to monitor (all in ONE instance) ───────────────────────────
ASSETS=btc,eth,sol,xrp,doge,hype,bnb      # crypto 5-minute up/down
ENABLE_WORLDCUP=true
WORLDCUP_MARKET_TYPES=moneyline,spreads,totals,btts

# ── Strategy ─────────────────────────────────────────────────────────────────
BUY_PRICE=0.999                           # the resting GTC buy price (placed ONLY if the
                                          #   market's LIVE tick can hit it exactly; we never
                                          #   settle for 0.99. Tick tightens to 0.001 near
                                          #   resolution — that's when we fire.)
TRIGGER_ASKS=0.999,1.0                    # place the buy when best ask is one of these
ORDER_SIZE_SHARES=5                       # global default shares/order (>= 5)
CRYPTO_ORDER_SIZE_SHARES=5                # shares/order on crypto 5m markets (defaults to ORDER_SIZE_SHARES)
WORLDCUP_ORDER_SIZE_SHARES=5              # shares/order on World Cup markets (defaults to ORDER_SIZE_SHARES)
MAX_OPEN_ORDERS=0                         # 0 = unlimited
ORDER_TTL_SECS=0                          # auto-cancel a resting buy if ask leaves band this long (0 = never)
CRYPTO_ORDER_MAX_AGE_MINS=45              # cancel CRYPTO resting orders older than this many minutes
                                          #   (a 0.999 buy unfilled past a 5m market's resolution is dead capital).
                                          #   Sports/World Cup orders are exempt. 0 = never cancel by age.

# ── COPYTRADER mode (follow a target trader; runs INSTEAD of the sniper) ─────
COPYTRADER_ENABLED=true                    # true = run the copytrader, not the sniper
TARGET_TRADER_ADDRESS=0x85dbcb1712ca38c639559351ad31127c472e1423
# DATA_SOURCE chooses how we detect the target's trades:
#   rest = Data-API polling   — slower (~1-3s) but works on datacenter IPs (AWS). RECOMMENDED on AWS.
#   ws   = activity WebSocket — faster (push), but Polymarket 429-throttles it on datacenter IPs;
#          only use ws from a residential / allowed-region IP (e.g. behind your proxy).
DATA_SOURCE=rest
COPY_POLL_MS=1000                          # Data-API poll cadence (DATA_SOURCE=rest only)

# brownfox: one fixed-SHARE buy per market at the target's exact price, +mark
# resting sell, forced exit if they sell below it.
USE_BROWNFOX_MODE=true
BROWNFOX_TRADE_SIZE_SHARES=50              # fixed SHARE count per market (not USD)
BROWNFOX_SELL_MARKUP=0.01                  # resting sell at buy + this (+1 cent)
BROWNFOX_RECONCILE_MS=3000
BROWNFOX_MARKET_SELL_RETRIES=8

# ── Infra ────────────────────────────────────────────────────────────────────
COPY_DATA_DIR=/data                        # persistent state dir (dedup + brownfox)
DASHBOARD_PORT=8090
POLYGON_RPC_URL=                          # optional custom Polygon RPC for balance reads
LOG_LEVEL=info
