[Unit]
Description=latebutfast Polymarket copytrader (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/latebutfast
# Secrets + config live here (chmod 600, owned by botuser). NEVER commit this.
EnvironmentFile=/opt/latebutfast/.env
ExecStart=/opt/latebutfast/latebutfast
Restart=on-failure
RestartSec=5
# Persisted state (dedup + brownfox markets)
Environment=COPY_DATA_DIR=/opt/latebutfast/data
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
